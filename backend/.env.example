APP_NAME=SD Financeiro ERP API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=false

API_V1_PREFIX=/api/v1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=sd_financeiro
DATABASE_USER=sd_admin
DATABASE_PASSWORD=change_me
DATABASE_ECHO=false
# SQL echo é recusado em todos os ambientes. Não usar com dados reais.

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Desenvolvimento local não exige senha no Redis do Compose.
# Staging/produção: injetar externamente REDIS_PASSWORD, DATABASE_PASSWORD e
# AUTH_RATE_LIMIT_KEY distintos, aleatórios, com pelo menos 32 bytes cada.
# APP_ENVIRONMENT também deve ser externo; nesses ambientes .env não é carregado.
# Gere um segredo aleatório com pelo menos 32 bytes; não versione o valor real.
# Sem chave, a API mantém o login indisponível (503).
AUTH_RATE_LIMIT_KEY=
AUTH_IDLE_TIMEOUT_SECONDS=1800
# Vagas por worker, compartilhadas entre login, propriedade, convites e perfis.
AUTH_HASH_CONCURRENCY=2
# Os limites abaixo configuram somente login; propriedade tem contadores próprios.
AUTH_ACCOUNT_LIMIT=5
AUTH_ACCOUNT_WINDOW_SECONDS=900
AUTH_ORIGIN_LIMIT=30
AUTH_ORIGIN_WINDOW_SECONDS=60
AUTH_GLOBAL_LIMIT=300
AUTH_GLOBAL_WINDOW_SECONDS=60

# Chaves opcionais Fernet, distintas entre si e dos demais segredos.
# Sem chave, o recurso correspondente permanece indisponível. Não versione valores reais.
# AUTH_MFA_ENCRYPTION_KEY=<chave-fernet-gerenciada>
# AUTH_IDENTITY_ENCRYPTION_KEY=<outra-chave-fernet-gerenciada>
# Provedor de e-mail ainda indefinido: não há transporte configurável neste incremento.
